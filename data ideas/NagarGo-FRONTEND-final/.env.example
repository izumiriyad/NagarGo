# =============================================================
# NagarGo — Environment Variables Template
# Copy this file to .env and fill in real values LOCALLY.
# NEVER commit .env. NEVER paste real secrets into chat, issues,
# or logs — anything shared that way should be treated as
# compromised and rotated immediately.
# =============================================================

# --- Core ---
NODE_ENV=development
PORT=4000
# Comma-separate multiple allowed origins for CORS/Socket.IO, e.g.
# a Vercel production URL + a preview URL + localhost for testing:
# APP_BASE_URL=https://nagargo.vercel.app,https://nagargo-git-preview.vercel.app,http://localhost:3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/nagargo_dev

# --- Auth / JWT ---
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Admin bootstrap ---
# The bootstrap PIN (5555) is only ever used to seed the FIRST
# admin account, and only if ADMIN_BOOTSTRAP_ENABLED=true. It is
# hashed before storage and the account is forced to change it
# on first login. Set this to false after initial setup.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_PIN=5555

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Telegram (admin operations feed) ---
# Create a bot via @BotFather to get a token, message the bot
# once, then call getUpdates (or use a helper bot like
# @userinfobot) to find your numeric chat id.
# Leave both blank to run with Telegram notifications disabled
# (events will be logged locally instead of sent).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LOCATION_UPDATE_INTERVAL_MINUTES=5

# --- Maps ---
GOOGLE_MAPS_API_KEY=

# --- File storage (Cloudinary or S3-compatible) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (fill in when real integrations are approved) ---
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=

# --- NagarGo Admin bKash (initial PaymentConfig seed value) ---
# This is a display/receiving number for the "Pay to Admin" flow,
# not a secret. It is still only ever seeded here — the live
# value lives in the PaymentConfig collection and is editable
# from the Admin Panel.
ADMIN_BKASH_NUMBER=+8801410348109
ADMIN_BKASH_ACCOUNT_TYPE=Personal
ADMIN_BKASH_INSTRUCTION=Send Money

# Web client (used by Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Client-side Maps JS key (Places + Directions + Maps rendering).
# Get this from Google Cloud Console → restrict it to your domain's
# HTTP referrers and to the Maps JavaScript API + Places API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
