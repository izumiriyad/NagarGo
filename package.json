{
  "name": "nagargo",
  "private": true,
  "version": "0.1.0",
  "description": "NagarGo — hyperlocal delivery and medicine express network (Rajshahi, Bangladesh)",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "build": "npm run build:api && npm run build:web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "start:api": "npm run start --workspace=apps/api",
    "start:web": "npm run start --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/api && npm run lint --workspace=apps/web",
    "test:api": "npm test --workspace=apps/api",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": "eslint --fix",
    "*.tsx": "eslint --fix"
  },
  "engines": {
    "node": ">=18.18"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pm2": "^7.0.4"
  }
}
